# Root env for Docker Compose. Copy to .env (gitignored) and fill real secrets on the box.
# The app container reads these; Symfony's real env vars override src/.env defaults.
#
# WHY APP_ENV=prod IS THE DEFAULT HERE, AND WHY THAT IS STILL FINE FOR LOCAL DEV.
# These values reach the container via `env_file: .env`, which OUTRANKS the `ENV APP_ENV=prod` baked
# into docker/php/Dockerfile. So whatever APP_ENV says here is what a production box actually runs
# as — which means the unsafe value must not be the default. `docker-compose.dev.yml` pins
# `APP_ENV: dev` in its `environment:` block (which in turn outranks `env_file:`), so `make up.dev`
# is a dev box regardless of this line and local dev needs no edit. Dev-ness follows the override
# file you load, not a value you remembered to change.
#
# The DB/Redis passwords below are DEV PLACEHOLDERS. They are safe on a laptop only because
# docker-compose.dev.yml binds Postgres to 127.0.0.1 and production publishes no datastore ports at
# all. Never deploy them: docs/access-setup.md §"Bootstrap the prod .env" is the authority for the
# real file, and it generates unique secrets with `openssl rand -hex 32`.

# App
APP_ENV=prod
APP_SECRET=change_me_generate_a_real_one   # openssl rand -hex 32

# framework.trusted_proxies (src/config/packages/framework.yaml) as a literal comma-separated CIDR
# list — the same ranges Symfony's `private_ranges` keyword expands to
# (Symfony\Component\HttpFoundation\IpUtils::PRIVATE_SUBNETS), spelled out because that keyword only
# works as a hardcoded YAML literal, not through an env var (see the long comment in framework.yaml).
# This is the PROD-correct value: prod always has exactly one real hop in front of nginx (Traefik, on
# a Docker network with a dynamic IP, hence "trust the private range" instead of a fixed address), and
# it is the default here for the same reason APP_ENV defaults to `prod` above — `env_file: .env`
# outranks the image, so whatever this file says is what a forgotten real box actually runs with, and
# the forgotten value must be the correct one rather than the disabled one.
# `docker-compose.dev.yml` overrides this to empty: dev has no reverse proxy in front of nginx at all
# (its port is published straight to the host), so trusting a private-range peer there would let
# anyone who can reach that port forge X-Forwarded-For and spoof any client IP they like.
TRUSTED_PROXIES=127.0.0.0/8,10.0.0.0/8,192.168.0.0/16,172.16.0.0/12,169.254.0.0/16,0.0.0.0/8,240.0.0.0/4,100.64.0.0/10,::1/128,fc00::/7,fe80::/10,::ffff:0:0/96,::/128,::/96,2002::/16,2001::/32,64:ff9b::/96,64:ff9b:1::/48

# PostgreSQL (postgres container + Symfony DATABASE_URL — keep credentials in sync)
DB_DATABASE=muzbar
DB_USERNAME=muzbar
DB_PASSWORD=muzbar
DATABASE_URL=postgresql://muzbar:muzbar@postgres:5432/muzbar?serverVersion=16&charset=utf8

# Redis (password-protected; URL includes the password)
REDIS_PASSWORD=muzbar
REDIS_URL=redis://:muzbar@redis:6379

# Mailer. A bare `smtp://` relay on the box is wrong here — Constitution §3 names an external
# transactional provider (Postmark/SendGrid) precisely so a rejected or spam-flagged send never
# touches the VDS's own IP reputation, which every other outbound thing on this box (including
# samolit) shares. Get the real DSN from the provider's dashboard and put it in the box's own
# gitignored .env; never commit it.
# MAILER_DSN=smtp://<postmark-token>:@smtp.postmarkapp.com:587
MAILER_DSN=smtp://CHANGE_ME_USE_A_TRANSACTIONAL_RELAY@example.invalid:587
MAILER_FROM=no-reply@muzbar.com

# Messenger. auto_setup=0 is deliberate: `messenger_messages` is created by a reviewed Doctrine
# migration (see identity-email-verification task T19), never by Messenger DDL-ing it at runtime on
# a live box.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Absolute-URL host for non-HTTP contexts (the messenger-worker process, console commands) — see
# AC-6 in docs/specs/identity-email-verification. Without this, a verification link rendered outside
# a browser request falls back to `src/.env`'s dev value and points at localhost in production.
DEFAULT_URI=https://muzbar.com
