<?xml version="1.0" encoding="UTF-8"?>
<!--
    `Price` as a Doctrine embeddable: the first multi-part value object (ADR-0007 amendment,
    ADR-0019 / plan D6). ADR-0007 d.4 rejected embeddables for *single-value* VOs; a price is an
    amount and a currency that only mean something together, so one VO maps to two columns here.

    Lives in its own directory, a sibling of `mapping/`, because a mapping block has one namespace
    prefix (this one is `App\Domain\Listing\ValueObject`, block `ListingValueObjects` in
    `doctrine.yaml`) and a block scans its directory recursively, so a subdirectory of `mapping/`
    would be read as a namespace segment of `…\Entity`.

    `amount` is BIGINT of minor units (never a float, never `numeric`; the `::bigint` lesson);
    `currency` stores the `Currency` backing value (ISO 4217 code).
-->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <embeddable name="App\Domain\Listing\ValueObject\Price">
        <field name="amountInMinorUnits" column="amount" type="bigint" nullable="false"/>
        <field name="currency" column="currency" type="string" length="3" nullable="false"
               enum-type="App\Domain\Listing\ValueObject\Currency"/>
    </embeddable>

</doctrine-mapping>
