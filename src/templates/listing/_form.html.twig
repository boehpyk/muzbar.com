{# Shared by the sell and edit pages. Root-level errors (bad CSRF token, extra fields such as a
   posted `seller`) land on the form, not a field. #}
{{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_row(form.title) }}
    {{ form_row(form.description) }}
    {{ form_row(form.price) }}
    {{ form_row(form.currency) }}
    {{ form_row(form.category) }}
    {% if form.attributes is defined %}
        <fieldset>
            <legend>Details</legend>
            {{ form_errors(form.attributes) }}
            {% for field in form.attributes %}
                {{ form_row(field) }}
            {% endfor %}
        </fieldset>
    {% endif %}
    <button type="submit">{{ button_label }}</button>
{{ form_end(form) }}
