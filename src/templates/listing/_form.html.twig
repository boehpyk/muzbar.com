{# Shared by the sell and edit pages. Root-level errors (bad CSRF token, extra fields such as a
   posted `seller`) land on the form, not a field. The caller passes `buttons`: a list of
   `{label, action?}`; an `action` is posted as the top-level `action` parameter (edit page:
   `save` | `publish`, listing-publish D12). #}
{{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_row(form.title) }}
    {{ form_row(form.description) }}
    {{ form_row(form.price) }}
    {{ form_row(form.currency) }}
    {{ form_row(form.category) }}
    {{ form_widget(form.details_for) }}
    {% if form.attributes is defined %}
        <fieldset>
            <legend>Details</legend>
            {{ form_errors(form.attributes) }}
            {% for field in form.attributes %}
                {{ form_row(field) }}
            {% endfor %}
        </fieldset>
    {% endif %}
    {% for button in buttons %}
        <button type="submit"{% if button.action is defined %} name="action" value="{{ button.action }}"{% endif %}>{{ button.label }}</button>
    {% endfor %}
{{ form_end(form) }}
