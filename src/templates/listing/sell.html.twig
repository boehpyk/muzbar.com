{% extends 'base.html.twig' %}

{% block title %}Sell gear{% endblock %}

{% block body %}
    <h1>Sell gear</h1>

    {% if form is null %}
        <p>Listings can't be created yet: there are no categories.</p>
    {% else %}
        {# "Save and publish" only beside Details (listing-wizard D4); the controller still decides. #}
        {% set buttons = with_details
            ? [{label: 'Save draft', action: 'save'}, {label: 'Save and publish', action: 'publish'}]
            : [{label: 'Save draft', action: 'save'}] %}
        {{ include('listing/_form.html.twig', {buttons: buttons}) }}
    {% endif %}

    <p><a href="{{ path('app_sell_drafts') }}">Your drafts</a></p>
{% endblock %}
