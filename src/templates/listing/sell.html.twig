{% extends 'base.html.twig' %}

{% block title %}Sell gear{% endblock %}

{% block body %}
    <h1>Sell gear</h1>

    {% if form is null %}
        <p>Listings can't be created yet: there are no categories.</p>
    {% else %}
        {# The component shows "Save and publish" only beside Details (D4); the controller still decides. #}
        <twig:ListingForm :form="form" :buttons="[{label: 'Save draft', action: 'save'}, {label: 'Save and publish', action: 'publish'}]" />
    {% endif %}

    <p><a href="{{ path('app_sell_drafts') }}">Your drafts</a></p>
{% endblock %}
