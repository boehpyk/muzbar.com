{% extends 'base.html.twig' %}

{% block title %}Edit listing{% endblock %}

{% block body %}
    <h1>Edit listing</h1>

    {# The buttons depend on the status (listing-publish AC-17); the controller decides what a
       clicked `publish` may do (only from a draft or a withdrawn listing, on an unchanged category). #}
    <p class="listing-status">Status: <strong>{{ draft.status|capitalize }}</strong>
        {% if draft.status == 'published' %}
            <a class="listing-public-link" href="{{ path('app_listing_show', {id: draft.id}) }}">View the public page</a>
        {% endif %}
    </p>

    {% if draft.status == 'published' %}
        {% set buttons = [{label: 'Save changes', action: 'save'}] %}
    {% elseif draft.status == 'withdrawn' %}
        {% set buttons = [{label: 'Save', action: 'save'}, {label: 'Save and publish again', action: 'publish'}] %}
    {% else %}
        {% set buttons = [{label: 'Save draft', action: 'save'}, {label: 'Save and publish', action: 'publish'}] %}
    {% endif %}

    {{ include('listing/_form.html.twig', {buttons: buttons}) }}

    {% if draft.status == 'published' %}
        {# A separate POST form with its own token, outside the listing form (D12). #}
        <form class="listing-withdraw" method="post" action="{{ path('app_sell_draft_withdraw', {id: draft.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('withdraw-listing-' ~ draft.id) }}">
            <button type="submit">Withdraw</button>
        </form>
    {% endif %}

    <p><a href="{{ path('app_sell_drafts') }}">Back to your listings</a></p>
{% endblock %}
