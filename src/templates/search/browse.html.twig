{% extends 'base.html.twig' %}

{% block title %}{{ category ? category.name : 'All categories' }}{% endblock %}

{# The facet URL space is combinatorial: keep crawlers out until search-ui decides canonical URLs (Q13). #}
{% block head %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    {# Unstyled, JS-free, semantic markup with stable class names (search-browse plan §Infrastructure).
       Facets work by submitting the form. No seller data reaches this template: no Search read
       selects `seller_id` (S-9). #}
    {% set query = result.query %}
    {# The surviving query — what every link carries — built once: `<main>`'s `data-search-url` (the
       address bar after an enhanced update, search-ui D3) and the alert slot read the same array.
       Never the raw query string: that echoes hostile, unknown and empty parameters. #}
    {% set searchParams = {category: categoryId, f: f, r: r, price: price, q: q}|merge(query.page > 1 ? {page: query.page} : {})|filter(v => v is not empty) %}
    {# Progressive enhancement (search-ui, ADR-0028): the `search` controller re-requests this same
       URL and swaps `<main>`. The status line lives outside `<main>` so it survives every swap. #}
    {# Never bind a keystroke event here: typing never searches (search-ui D4, AC-12). #}
    <div class="search-page" data-controller="search" data-action="change->search#change submit->search#submit click->search#follow popstate@window->search#restore">
    <p class="visually-hidden" role="status" aria-live="polite" data-search-target="status"></p>
    <main class="search-browse" data-search-url="{{ path('app_browse', searchParams) }}">
        <h1 id="search-heading" tabindex="-1">{{ category ? category.name : 'All categories' }}</h1>

        {% if breadcrumb is not empty %}
            <nav class="search-breadcrumb" aria-label="Breadcrumb">
                <a href="{{ path('app_browse', {f: f, r: r, price: price, q: q}) }}">All categories</a>
                {% for crumb in breadcrumb %}
                    › <a href="{{ path('app_browse', {category: crumb.id, f: f, r: r, price: price, q: q}) }}">{{ crumb.name }}</a>
                {% endfor %}
            </nav>
        {% endif %}

        {% if children is not empty %}
            <ul class="search-categories">
                {% for child in children %}
                    <li><a href="{{ path('app_browse', {category: child.id, f: f, r: r, price: price, q: q}) }}">{{ child.name }}</a></li>
                {% endfor %}
            </ul>
        {% endif %}

        <a class="skip-link" href="#search-results">Skip to results</a>

        {# Always rendered: the price filter applies with or without a category (search-range-facets Q7). #}
        <form class="search-facets" method="get" action="{{ path('app_browse') }}">
            {% if categoryId %}
                <input type="hidden" id="search-category" name="category" value="{{ categoryId }}">
            {% endif %}
            {# Control ids are built from what the control means, so the same control has the same id on
               any page that shows it — the search controller refocuses by id after a swap (AC-5). #}
            {# Shows the surviving terms, not what was typed. maxlength mirrors the Domain cap; it is not the guard (S-15). #}
            <label class="search-text">
                Search
                <input type="search" id="search-q" name="q" value="{{ q }}" maxlength="{{ constant('App\\Domain\\Search\\ValueObject\\SearchTerms::MAX_LENGTH') }}">
            </label>
            {% for facet in result.facets %}
                {% set attributeId = facet.attribute.attributeId.toString %}
                {% if facet.attribute.kind.value == 'number' %}
                    {# No min/max attributes: the rules' bounds are a write rule, not a search limit (S-12). #}
                    <fieldset class="search-facet search-facet--range">
                        <legend>{{ facet.attribute.label }}{% if facet.attribute.unit %} ({{ facet.attribute.unit }}){% endif %}</legend>
                        <label>
                            From
                            <input type="number" step="1" inputmode="numeric" id="search-r-{{ attributeId }}-min" name="r[{{ attributeId }}][min]" value="{{ facet.selected.min ?? '' }}" placeholder="{{ facet.observed.min ?? '' }}">
                        </label>
                        <label>
                            To
                            <input type="number" step="1" inputmode="numeric" id="search-r-{{ attributeId }}-max" name="r[{{ attributeId }}][max]" value="{{ facet.selected.max ?? '' }}" placeholder="{{ facet.observed.max ?? '' }}">
                        </label>
                        <p>{{ facet.count }} {{ facet.count == 1 ? 'listing' : 'listings' }}{% if facet.observed %}, {{ facet.observed.min }}–{{ facet.observed.max }}{% endif %}</p>
                    </fieldset>
                {% else %}
                    <fieldset class="search-facet">
                        <legend>{{ facet.attribute.label }}</legend>
                        {% for bucket in facet.buckets %}
                            <label>
                                <input type="checkbox" id="search-f-{{ attributeId }}-{{ bucket.value }}" name="f[{{ attributeId }}][]" value="{{ bucket.value }}"{% if bucket.selected %} checked{% endif %}>
                                {{ bucket.label }} ({{ bucket.count }})
                            </label>
                        {% endfor %}
                    </fieldset>
                {% endif %}
            {% endfor %}
            <fieldset class="search-price">
                <legend>Price</legend>
                <label for="search-price-currency">Currency</label>
                <select id="search-price-currency" name="price[currency]">
                    <option value="">Any currency</option>
                    {% for currency in currencies %}
                        <option value="{{ currency.value }}"{% if currency.value == (price.currency ?? '') %} selected{% endif %}>{{ currency.value }}</option>
                    {% endfor %}
                </select>
                <label>
                    From
                    <input type="number" min="0" max="9999999" step="1" inputmode="numeric" id="search-price-min" name="price[min]" value="{{ price.min ?? '' }}">
                </label>
                <label>
                    To
                    <input type="number" min="0" max="9999999" step="1" inputmode="numeric" id="search-price-max" name="price[max]" value="{{ price.max ?? '' }}">
                </label>
                <p>Choosing a currency hides listings priced in other currencies.</p>
            </fieldset>
            <button type="submit">Apply filters</button>
            <a href="{{ path('app_browse', {category: categoryId}) }}">Clear filters</a>
        </form>

        <section class="search-results" id="search-results">
            {% if result.textMatch == constant('App\\Domain\\Search\\ValueObject\\TextMatch::Similar') %}
                <p class="search-similar">No exact matches for “{{ q }}”. Showing listings with similar titles.</p>
            {% endif %}
            <p class="search-total">{{ result.total }} {{ result.total == 1 ? 'listing' : 'listings' }}</p>

            {# The 0-result state is `total == 0`, never `hits is empty`: a page past the end has hits on
               other pages and keeps its "First page" link below (AC-8). #}
            {% if result.total == 0 %}
                <section class="search-empty" aria-labelledby="search-empty-heading">
                    <h2 id="search-empty-heading">No listings found.</h2>
                    {% if q %}
                        <p>Nothing matched your search for “{{ q }}”.</p>
                    {% endif %}
                    {% if f or r or price or q %}
                        <p><a href="{{ path('app_browse', {category: categoryId}) }}">Clear filters</a></p>
                    {% endif %}
                    {# Category-bound `f`/`r` do not survive leaving the category; text and price do. #}
                    {% if categoryId %}
                        <p><a href="{{ path('app_browse', {q: q, price: price}) }}">Search all categories</a></p>
                    {% endif %}
                    <div data-search-alert-slot>{% include 'search/_alert_slot.html.twig' with {search: searchParams} only %}</div>
                </section>
            {% elseif result.hits is empty %}
                <p>No listings found.</p>
            {% else %}
                <ol>
                    {% for hit in result.hits %}
                        <li class="search-hit">
                            <a href="{{ path('app_listing_show', {id: hit.id}) }}">{{ hit.title }}</a>
                            <span>{{ hit.price }} {{ hit.currency }}</span>
                            <time datetime="{{ hit.publishedAt }}">{{ hit.publishedAt|date('j M Y') }}</time>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}

            {% set hasNext = query.page * perPage < result.total and query.page < maxPage %}
            {% if query.page > 1 or hasNext %}
                <nav class="search-pager" aria-label="Pages">
                    {% if query.page > 1 and result.hits is empty %}
                        <a href="{{ path('app_browse', {category: categoryId, f: f, r: r, price: price, q: q}) }}">First page</a>
                    {% elseif query.page > 1 %}
                        <a href="{{ path('app_browse', {category: categoryId, f: f, r: r, price: price, q: q, page: query.page - 1}) }}" rel="prev">Previous</a>
                    {% endif %}
                    {% if hasNext %}
                        <a href="{{ path('app_browse', {category: categoryId, f: f, r: r, price: price, q: q, page: query.page + 1}) }}" rel="next">Next</a>
                    {% endif %}
                </nav>
            {% endif %}
        </section>
    </main>
    </div>
{% endblock %}
