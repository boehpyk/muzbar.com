{# Standalone on purpose — it does not extend base.html.twig, whose skeleton favicon, `app`
   importmap and flash block have nothing to do on a pre-launch page. See coming-soon.css. #}
{% trans_default_domain 'coming_soon' %}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>muzbar.com — {{ 'kicker'|trans }}</title>
        <meta name="description" content="{{ 'body'|trans }}">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%230f0e0c%22/><text x=%2250%22 y=%2274%22 text-anchor=%22middle%22 font-family=%22sans-serif%22 font-weight=%22900%22 font-size=%2270%22 fill=%22%23f2ede4%22>M<tspan fill=%22%23ff4a1c%22>.</tspan></text></svg>">
        <link rel="preload" href="{{ asset('fonts/unbounded-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="{{ asset('styles/coming-soon.css') }}">
    </head>
    <body>
        <div class="coming-soon">
            <header>
                <div class="coming-soon__logo">MUZBA<span class="accent">R</span></div>
            </header>

            <main class="coming-soon__main">
                <div class="coming-soon__kicker">{{ 'kicker'|trans }}</div>
                <h1 class="coming-soon__title">muzbar<span class="accent">.com</span></h1>
                <p class="coming-soon__body">{{ 'body'|trans }}</p>

                {# The flash exists only on the GET after a successful POST (see the controller's
                   Post/Redirect/Get), so "thanks" replaces the form exactly once. #}
                {% set thanked = app.flashes('launch_signup') %}
                {% if thanked is not empty %}
                    <p class="coming-soon__thanks" role="status">{{ 'thanks'|trans }}</p>
                {% else %}
                    {{ form_start(signupForm, {attr: {class: 'coming-soon__form', novalidate: 'novalidate'}}) }}
                        <div class="coming-soon__field">
                            {{ form_widget(signupForm.email, {attr: {class: 'coming-soon__input'}}) }}
                            <button type="submit" class="coming-soon__button">{{ 'cta'|trans }}</button>
                        </div>
                        {# Root errors carry an invalid CSRF token and the rate-limit refusal; without
                           this line either one would look like a page that silently did nothing. #}
                        <div class="coming-soon__errors">
                            {{ form_errors(signupForm) }}
                            {{ form_errors(signupForm.email) }}
                        </div>
                    {{ form_end(signupForm) }}
                {% endif %}
            </main>

            <footer class="coming-soon__footer">
                <span>{{ 'footer'|trans }}</span>
                <span>© 2008–{{ 'now'|date('Y') }} MuzBar.com</span>
            </footer>
        </div>
    </body>
</html>
