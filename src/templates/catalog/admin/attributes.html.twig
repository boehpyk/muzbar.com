{% extends 'admin/layout.html.twig' %}

{% set typeNames = {choice: 'Choice', number: 'Number', boolean: 'Yes/no', text: 'Text'} %}

{% block title %}Attributes of {{ category.name }}{% endblock %}

{% block body %}
    <h1>Attributes of “{{ category.name }}”</h1>

    <p>
        Define:
        {% for type in types %}
            <a href="{{ path('admin_attribute_new', {id: category.id, type: type.value}) }}">{{ typeNames[type.value] }}</a>
        {% endfor %}
    </p>

    {# Own and inherited rows, with option counts, come from one query
       (`DbalAttributeSchema::effectiveFor()`, AC-24), root first, then by label case-insensitively.
       Nothing is copied down the tree (C-22): an inherited attribute is edited on the category that
       defines it, so its row has no controls and no token. Unstyled on purpose. #}
    {% set own = attributes|filter(a => not a.inherited) %}
    {% set inherited = attributes|filter(a => a.inherited) %}

    <h2>Defined here</h2>
    {% if own is empty %}
        <p>No attributes of its own.</p>
    {% else %}
        <table>
            <thead>
                <tr><th>Label</th><th>Code</th><th>Type</th><th>Required</th><th>Details</th><th>Actions</th></tr>
            </thead>
            <tbody>
                {% for attribute in own %}
                    <tr>
                        {{ _self.cells(attribute, typeNames) }}
                        <td>
                            <a href="{{ path('admin_attribute_edit', {id: attribute.id}) }}">Edit</a>
                            {# A form, never a link: no GET may change state (ADR-0015). #}
                            <form method="post" action="{{ path('admin_attribute_archive', {id: attribute.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('archive-attribute-' ~ attribute.id) }}">
                                <button type="submit">Archive</button>
                            </form>
                            <form method="post" action="{{ path('admin_attribute_delete', {id: attribute.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-attribute-' ~ attribute.id) }}">
                                <button type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {# Archived rows show only on their defining category (ADR-0022, AC-16): `effectiveFor()` is
       active-only, `archivedDefinedOn()` reads this category's own archived attributes. Their codes
       stay reserved (C-29), which is why Restore needs no check. #}
    {% if archived is not empty %}
        <h2>Archived</h2>
        <table class="archived-attributes">
            <thead>
                <tr><th>Label</th><th>Code</th><th>Type</th><th>Required</th><th>Details</th><th>Archived</th><th>Actions</th></tr>
            </thead>
            <tbody>
                {% for attribute in archived %}
                    <tr>
                        {{ _self.cells(attribute, typeNames) }}
                        <td>Archived on {{ attribute.archivedAt|date('j M Y') }}</td>
                        <td>
                            <a href="{{ path('admin_attribute_edit', {id: attribute.id}) }}">Edit</a>
                            <form method="post" action="{{ path('admin_attribute_restore', {id: attribute.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('restore-attribute-' ~ attribute.id) }}">
                                <button type="submit">Restore</button>
                            </form>
                            <form method="post" action="{{ path('admin_attribute_delete', {id: attribute.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-attribute-' ~ attribute.id) }}">
                                <button type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if inherited is not empty %}
        <h2>Inherited</h2>
        <table>
            <thead>
                <tr><th>Label</th><th>Code</th><th>Type</th><th>Required</th><th>Details</th><th>Defined on</th></tr>
            </thead>
            <tbody>
                {% for attribute in inherited %}
                    <tr>
                        {{ _self.cells(attribute, typeNames) }}
                        <td>from <a href="{{ path('admin_attribute_index', {id: attribute.definedOnId}) }}">{{ attribute.definedOnName }}</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <p><a href="{{ path('admin_category_index') }}">Back to categories</a></p>
{% endblock %}

{% macro cells(attribute, typeNames) %}
    <td>{{ attribute.label }}</td>
    <td>{{ attribute.code }}</td>
    <td>{{ typeNames[attribute.type] }}</td>
    <td>{{ attribute.required ? 'required' : '' }}</td>
    <td>
        {% if attribute.type == 'number' %}
            {% if attribute.unit is not null %}unit: {{ attribute.unit }}{% endif %}
            {% if attribute.minimum is not null %}min: {{ attribute.minimum }}{% endif %}
            {% if attribute.maximum is not null %}max: {{ attribute.maximum }}{% endif %}
        {% elseif attribute.type == 'choice' and attribute.archivedAt is not defined %}
            {{ attribute.optionCount }} {{ attribute.optionCount == 1 ? 'option' : 'options' }}
        {% endif %}
    </td>
{% endmacro %}
