{% extends 'base.html.twig' %}

{% block title %}Edit {{ category.name }}{% endblock %}

{% block body %}
    <h1>Edit “{{ category.name }}”</h1>

    {{ form_start(form) }}
        {# Root-level errors (an invalid CSRF token, extra fields) land on the form, not a field. #}
        {{ form_errors(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.slug) }}
        {{ form_row(form.parent) }}
        <button type="submit">Save</button>
    {{ form_end(form) }}

    <p><a href="{{ path('admin_category_index') }}">Back to categories</a></p>
{% endblock %}
