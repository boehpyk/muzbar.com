{% extends 'admin/layout.html.twig' %}

{% set typeNames = {choice: 'Choice', number: 'Number', boolean: 'Yes/no', text: 'Text'} %}

{% block title %}Edit {{ attribute.label }}{% endblock %}

{% block body %}
    <h1>Edit “{{ attribute.label }}”</h1>

    {# An archived attribute stays editable (ADR-0022 Q6) — recoding it frees its reserved code. #}
    {% if attribute.archivedAt is not null %}
        <div class="archived-banner">
            <p>Archived on {{ attribute.archivedAt|date('j M Y') }} — sellers don't see it.</p>
            <form method="post" action="{{ path('admin_attribute_restore', {id: attribute.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('restore-attribute-' ~ attribute.id) }}">
                <button type="submit">Restore</button>
            </form>
        </div>
    {% endif %}

    {# The type never changes (C-14), so it is text, not a field. #}
    <p>Type: {{ typeNames[type.value] }}</p>

    {# Nothing is copied down the tree (C-22): a change here is what every descendant reads. #}
    {% if categoryName is not null %}
        <p>Changes apply to “{{ categoryName }}” and every category below it.</p>
    {% endif %}

    {{ form_start(form) }}
        {# Root-level errors (an invalid CSRF token, extra fields) land on the form, not a field. #}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
        <button type="submit">Save</button>
    {{ form_end(form) }}

    {% if type.value == 'choice' %}
        <h2>Options</h2>
        {# In insertion order (`ORDER BY id`, C-19), unpaginated (owner, Q10). One token per attribute
           serves every option form (plan D11). Each action answers 303 back here with a flash. #}
        {% set optionsToken = csrf_token('attribute-options-' ~ attribute.id) %}
        <ul class="active-options">
            {% for option in options|filter(o => o.archivedAt is null) %}
                <li>
                    <form method="post" action="{{ path('admin_attribute_option_relabel', {id: attribute.id, optionId: option.id}) }}">
                        <input type="hidden" name="_token" value="{{ optionsToken }}">
                        <input type="text" name="label" value="{{ option.label }}" aria-label="Option label" required>
                        <button type="submit">Rename</button>
                    </form>
                    <form method="post" action="{{ path('admin_attribute_option_archive', {id: attribute.id, optionId: option.id}) }}">
                        <input type="hidden" name="_token" value="{{ optionsToken }}">
                        <button type="submit">Archive</button>
                    </form>
                    <form method="post" action="{{ path('admin_attribute_option_remove', {id: attribute.id, optionId: option.id}) }}">
                        <input type="hidden" name="_token" value="{{ optionsToken }}">
                        <button type="submit">Remove</button>
                    </form>
                </li>
            {% endfor %}
        </ul>

        {# Archived labels stay reserved (C-29): adding one again is refused, restoring it is not. #}
        {% set archivedOptions = options|filter(o => o.archivedAt is not null) %}
        {% if archivedOptions is not empty %}
            <h2>Archived options</h2>
            <ul class="archived-options">
                {% for option in archivedOptions %}
                    <li>
                        {{ option.label }} — archived on {{ option.archivedAt|date('j M Y') }}
                        <form method="post" action="{{ path('admin_attribute_option_restore', {id: attribute.id, optionId: option.id}) }}">
                            <input type="hidden" name="_token" value="{{ optionsToken }}">
                            <button type="submit">Restore</button>
                        </form>
                        <form method="post" action="{{ path('admin_attribute_option_remove', {id: attribute.id, optionId: option.id}) }}">
                            <input type="hidden" name="_token" value="{{ optionsToken }}">
                            <button type="submit">Delete</button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <form method="post" action="{{ path('admin_attribute_option_add', {id: attribute.id}) }}">
            <input type="hidden" name="_token" value="{{ optionsToken }}">
            <input type="text" name="label" aria-label="New option label" required>
            <button type="submit">Add option</button>
        </form>
    {% endif %}

    <p><a href="{{ path('admin_attribute_index', {id: attribute.categoryId}) }}">Back to attributes</a></p>
{% endblock %}
