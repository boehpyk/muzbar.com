{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block body %}
    <h1>Reset your password</h1>

    <p>Enter the address you registered with and we will send you a link for setting a new password.</p>

    {# `form_start`/`form_end` render `forgot_password_form[_token]` and the single field with its
       errors. Unstyled on purpose — see `register.html.twig`. #}
    {{ form_start(forgotPasswordForm) }}
        {# Root-level errors: an invalid CSRF token and the `allow_extra_fields: false` rejection both
           land on the form itself rather than on any field, and neither `form_start` nor `form_end`
           renders them. Omit this line and a rejected submit looks like a page that silently did
           nothing — which, on the most probed endpoint in the slice, is also the behaviour least
           likely to be noticed. #}
        {{ form_errors(forgotPasswordForm) }}

        {{ form_row(forgotPasswordForm.email) }}

        <button type="submit">Send a reset link</button>
    {{ form_end(forgotPasswordForm) }}

    {# NOTHING ON THIS PAGE REPORTS STATE, AND THERE IS NOTHING HERE THAT COULD (AC-5). No "we last
       sent you a link at…", no "no account uses that address", no "that account has had three links
       this hour", no timestamp. The controller's answer to every well-formed submission is one
       redirect with one sentence; this template is the other half of that promise, and a field error
       here for anything other than syntax would undo it. #}

    <p><a href="{{ path('app_login') }}">Back to sign in</a></p>
{% endblock %}
