{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
    <h1>Sign in</h1>

    {#
        AC-12 / AC-13 — USER ENUMERATION.

        The error is rendered through the framework's own translated message key and nothing else.
        With `hide_user_not_found` at its secure default, Symfony raises a `BadCredentialsException`
        for *both* an unknown email and a wrong password, so both produce the identical string
        "Invalid credentials." — same status, same markup, same bytes.

        Do not add a condition here. Anything of the form `{% if error is instanceof(...) %}` or
        "we could not find that account" turns this page into a free oracle for enumerating who has
        registered. The throttling message is the one exception, and it comes from the same
        `messageKey` mechanism rather than from a branch in this template.
    #}
    {% if error %}
        <p class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <label for="username">Email</label>
        <input type="email" id="username" name="_username" value="{{ lastUsername }}" autocomplete="email" required autofocus>

        <label for="password">Password</label>
        <input type="password" id="password" name="_password" autocomplete="current-password" required>

        {# Session-backed CSRF (config/packages/csrf.yaml). The `authenticate` token id is what
           `form_login`'s `enable_csrf: true` expects; renaming it silently breaks every login. #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Sign in</button>
    </form>

    <p><a href="{{ path('app_register') }}">Need an account? Register</a></p>

    {# The escape hatch for the failure this page can now produce and could not before (AC-20).
       `VerifiedAccountUserChecker` refuses an unverified account *after* a correct password, so a
       user with the right credentials can be turned away by the error block above with no way
       forward — the link they needed is in an inbox they cannot find. An unconditional link is
       correct here rather than one shown only after that specific error: a condition would have to
       inspect the exception, which is exactly the branching this template's main comment forbids,
       and it would announce to anyone reading the page that verification state is a thing this form
       distinguishes. Shown to everybody, it tells nobody anything. #}
    <p><a href="{{ path('app_verify_email_resend') }}">Didn't get the verification email?</a></p>
{% endblock %}
