# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# NOTE: there is deliberately NO DATABASE_URL here, and adding one would be a mistake.
# The test suite must never touch the dev database — and it doesn't: `config/packages/doctrine.yaml`
# sets `when@test: dbal.dbname_suffix: '_test%env(default::TEST_TOKEN)%'`, so under APP_ENV=test
# Doctrine takes the DATABASE_URL from .env and connects to **muzbar_test**, not muzbar.
# Overriding DATABASE_URL here would bypass that suffix and re-point tests at the dev DB.
# `make test` depends on `make test.db`, which creates and migrates muzbar_test before PHPUnit runs.
