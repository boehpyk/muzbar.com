# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# NOTE: there is deliberately NO DATABASE_URL here, and adding one would be a mistake.
# The test suite must never touch the dev database — and it doesn't: `config/packages/doctrine.yaml`
# sets `when@test: dbal.dbname_suffix: '_test%env(default::TEST_TOKEN)%'`, so under APP_ENV=test
# Doctrine takes the DATABASE_URL from .env and connects to **muzbar_test**, not muzbar.
# Overriding DATABASE_URL here would bypass that suffix and re-point tests at the dev DB.
# `make test` depends on `make test.db`, which creates and migrates muzbar_test before PHPUnit runs.

# Tests must never hit a real SMTP socket, so this overrides `.env`'s dev Mailpit DSN — swap the
# `null` transport for `MailerAssertionsTrait` to inspect sent messages instead.
MAILER_DSN=null://null

# No HTTP request context in a test either, so this must be set explicitly rather than inherited —
# `http://localhost` (no port) is fine here because tests never render a link against a real dev
# server; see AC-6 and the fuller explanation in `.env`.
DEFAULT_URI=http://localhost

# Same value as `.env` (no trust — nothing sits in front of the test process either), restated
# explicitly rather than left to inherit, the same way DEFAULT_URI is above: a functional test
# boots a real kernel via `KernelBrowser`, and `WebTestCase` requests default `REMOTE_ADDR` to
# `127.0.0.1`, which — being a loopback address — would itself be considered a trusted private-range
# peer if `TRUSTED_PROXIES` here were ever set to the private-range list by mistake. Left empty, the
# IP-keyed rate limiter tests (AC-18) key on `127.0.0.1` exactly as they did before `trusted_proxies`
# existed, with nothing to accidentally forge via a test-sent `X-Forwarded-For` header.
TRUSTED_PROXIES=
