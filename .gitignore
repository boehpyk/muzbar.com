# Secrets & env — repo-root only (Symfony's own src/.env is committed; src/.gitignore governs src/)
/.env
/.env.local
/.env.*.local
!/.env.example

# Symfony
/src/var/
/src/vendor/
/src/public/bundles/
/src/public/build/
/src/public/assets/
/src/config/secrets/*/*.decrypt.private.php

# Node / assets
node_modules/
/src/node_modules/

# Docker / runtime
/storage/logs/*
!/storage/logs/.gitkeep
/backups/*
!/backups/.gitkeep

# Tooling caches
.php-cs-fixer.cache
.phpstan.cache
/src/.phpunit.result.cache
.phpunit.cache/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Claude Code local
.claude/settings.local.json
.claude/scheduled_tasks.lock

#Some private docs
docs/explanations
/FORboehpyk.md
